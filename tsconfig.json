{
	"compilerOptions": {
		"experimentalDecorators": true,
		"module": "esnext",
		"target": "es2015",
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
		"noEmit": true,
		"lib": [
			"es2017"
		]
	},
	"include": [
		"voxmate.ts",
		"types.d.ts",
		"utility/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"utility/*.test.ts",
		"vitest.config.ts"
	]
}
